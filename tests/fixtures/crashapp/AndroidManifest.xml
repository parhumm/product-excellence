<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.pex.crashapp">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />
  <application android:theme="@android:style/Theme.Material.Light" android:label="PEX Crash App">
    <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
